config_version=5

[application]

config/name="Gunlord"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://assets/art/icon.png"
boot_splash/bg_color=Color(0.07, 0.09, 0.15, 1)
boot_splash/image="res://assets/art/splash.png"
boot_splash/stretch_mode=4

[audio]

driver/output_latency.web=340

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
