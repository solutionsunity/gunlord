#!/usr/bin/env python
# Builds the native library: scons platform=web threads=no target=template_release
# godot-cpp is checked out beside this file's parent repo, or at GODOT_CPP.
import os

env = SConscript(os.environ.get("GODOT_CPP", "godot-cpp") + "/SConstruct")
env.Append(CPPPATH=["src/"])
sources = Glob("src/*.cpp")
library = env.SharedLibrary("bin/gunlord{}{}".format(env["suffix"], env["SHLIBSUFFIX"]), source=sources)
Default(library)
